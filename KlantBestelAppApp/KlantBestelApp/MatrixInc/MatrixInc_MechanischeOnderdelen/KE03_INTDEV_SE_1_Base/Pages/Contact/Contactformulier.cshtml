@page
@model KE03_INTDEV_SE_1_Base.Pages.Contact.ContactformulierModel

@* JUNIOR-UITLEG: Bestand: KE03_INTDEV_SE_1_Base/Pages/Contact/Contactformulier.cshtml
   Dit Razor Page-bestand bevat de HTML die de gebruiker in de browser ziet.
   De bijbehorende .cshtml.cs file regelt alleen de noodzakelijke data/logica. *@


@* EXTRA BEGINNER-UITLEG
   - @page betekent: dit bestand is een Razor Page die direct via een URL geopend kan worden.
   - @model koppelt deze HTML-pagina aan de C# PageModel-class in het .cshtml.cs bestand.
   - asp-page is een Razor Tag Helper. Die maakt automatisch de juiste link naar een andere pagina.
   - @Model betekent: gegevens die vanuit C# naar deze HTML-pagina zijn gestuurd.
   - Alles tussen <section>, <div>, <article> en <form> is gewone HTML-opmaak voor de browser.
   - De echte styling staat niet hier, maar in het bijbehorende CSS-bestand in wwwroot/css.
*@

@{
    ViewData["Title"] = "Contact";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Contact/contactformulier.css" asp-append-version="true" />
}
@* PAGINA-UITLEG VOOR JUNIOR
   Doel: decoratieve contactpagina.
   Relatie: bereikbaar vanuit footer.
   Logica: formulier is voor de uitstraling en verstuurt niets. *@


<!-- Contactformulier voor extra realistische webshopinformatie. Het formulier verstuurt niets. -->
@* Contactpagina voor uitstraling en servicegevoel.
   De knop is type="button" en niet type="submit", dus het formulier verstuurt niets.
   Hierdoor blijft er geen extra C# logica nodig. *@
<section class="contact-layout">
    <div class="card contact-card">
        <span class="badge"><i data-lucide="messages-square"></i> Contact</span>
        <h1>Advies nodig?</h1>
        <p class="muted">Stel een vraag over mechanische onderdelen, levering of je bestelling.</p>
        <label><i data-lucide="user"></i> Naam</label><input placeholder="Jouw naam" />
        <label><i data-lucide="mail"></i> E-mail</label><input placeholder="jouw@email.nl" />
        <label><i data-lucide="message-circle"></i> Vraag</label><textarea placeholder="Typ hier je vraag"></textarea>
        <button type="button"><i data-lucide="send"></i> Bericht voorbeeld</button>
    </div>
    <aside class="card contact-side">
        <h2><i data-lucide="headphones"></i> Klantenservice</h2>
        <p><strong>Maandag t/m vrijdag</strong><br />09:00 - 17:00</p>
        <p class="muted">Voor productadvies, levertijd en bestelvragen.</p>
        <ul>
            <li><i data-lucide="phone"></i> 088 - 123 4567</li>
            <li><i data-lucide="mail"></i> service@matrixinc.nl</li>
            <li><i data-lucide="map-pin"></i> Eindhoven</li>
        </ul>
    </aside>
</section>
