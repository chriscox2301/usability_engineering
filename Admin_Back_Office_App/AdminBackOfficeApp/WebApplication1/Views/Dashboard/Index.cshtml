@model AdminDashboardViewModel
@* model-directive bepaalt welk type data deze View ontvangt van DashboardController.Index(). *@
@{
    ViewData["Title"] = "Dashboard";
}
@section Styles { <link rel="stylesheet" href="~/css/dashboard/index.css" asp-append-version="true" /> }
@* Deze section wordt in _Layout.cshtml geladen via RenderSectionAsync("Styles"). *@


@*
    JUNIOR-UITLEG Dashboard/Index.cshtml
    Relatie met controller: DashboardController.Index vult AdminDashboardViewModel.
    Relatie met CSS: wwwroot/css/dashboard/index.css kleurt KPI-randen en detailblokken.
    Technisch: KPI-kaarten zijn anchors met asp-controller/asp-action en linken direct naar de juiste controlleractie.
*@
<section class="page-heading">
    <div>
        <p class="eyebrow">Back-office</p>
        <h1>Dashboard</h1>
        <p>Overzicht van voorraadrisico's, open orders en klantenservice-signalen die aandacht nodig hebben.</p>
    </div>
</section>

@* KPI-grid: elke KPI is een <a>-tag met tag helpers. asp-controller en asp-action maken automatisch de juiste URL. *@
<section class="kpi-grid" aria-label="Actiegerichte dashboard signalen">
    <a class="kpi-card kpi-stock" asp-controller="Voorraad" asp-action="Index" title="Bekijk voorraad met risico">
        <i data-lucide="triangle-alert"></i>
        <span>Lage voorraad</span>
        <strong>@Model.AantalLageVoorraadProducten</strong>
        <small>Ga direct naar voorraadbeheer.</small>
    </a>

    <a class="kpi-card kpi-orders" asp-controller="Bestellingen" asp-action="Index" asp-route-status="Nieuw" title="Bekijk nieuwe bestellingen">
        <i data-lucide="clipboard-list"></i>
        <span>Nieuwe bestellingen</span>
        <strong>@Model.AantalNieuweBestellingen</strong>
        <small>Controleer orders die nog niet verwerkt zijn.</small>
    </a>

    <a class="kpi-card kpi-concepts" asp-controller="Klantenservice" asp-action="Index" title="Bekijk openstaande klachten">
        <i data-lucide="headset"></i>
        <span>Klachten</span>
        <strong>@Model.AantalOpenstaandeKlachten</strong>
        <small>Bekijk klachten die nog niet zijn afgehandeld.</small>
    </a>

    <a class="kpi-card kpi-priority" asp-controller="Bestellingen" asp-action="Index" asp-route-prioriteit="Hoog" title="Bekijk hoge prioriteit bestellingen">
        <i data-lucide="flame"></i>
        <span>Hoge prioriteit</span>
        <strong>@Model.AantalHogePrioriteitBestellingen</strong>
        <small>Pak urgente orders sneller op.</small>
    </a>
</section>

@* Dashboard-grid: deze detailblokken gebruiken dezelfde ViewModel-lijsten als de KPI-tellingen. *@
<section class="dashboard-grid">
    <article class="panel dashboard-panel dashboard-panel-stock">
        <div class="panel-header">
            <h2><span class="panel-color-dot stock-dot"></span>Voorraad met risico</h2>
            <a asp-controller="Voorraad" asp-action="Index">Bekijk voorraad</a>
        </div>
        <div class="list-stack">
            @* foreach loopt door de lijst ProductenMetLageVoorraad uit AdminDashboardViewModel. *@
            @foreach (var product in Model.ProductenMetLageVoorraad)
            {
                <div class="list-row attention-row dashboard-row-stock">
                    <span class="row-icon"><i data-lucide="@product.Icoon"></i></span>
                    <div><strong>@product.Naam</strong><small>@product.Artikelnummer · @product.Leverancier</small></div>
                    <span class="badge badge-warning">@product.Voorraad op voorraad</span>
                </div>
            }
        </div>
    </article>

    <article class="panel dashboard-panel dashboard-panel-orders">
        <div class="panel-header">
            <h2><span class="panel-color-dot orders-dot"></span>Nieuwe bestellingen</h2>
            <a asp-controller="Bestellingen" asp-action="Index" asp-route-status="Nieuw">Alle nieuwe bestellingen</a>
        </div>
        <div class="list-stack">
            @* foreach loopt door de lijst NieuweBestellingen uit AdminDashboardViewModel. *@
            @foreach (var bestelling in Model.TeVerwerkenBestellingen)
            {
                <div class="list-row dashboard-row-orders">
                    <span class="row-icon"><i data-lucide="receipt"></i></span>
                    <div><strong>@bestelling.Ordernummer</strong><small>@bestelling.KlantNaam · @bestelling.Datum</small></div>
                    <span class="badge @(bestelling.Prioriteit == "Hoog" ? "badge-warning" : "badge-soft")">@bestelling.Status</span>
                </div>
            }
        </div>
    </article>

    <article class="panel dashboard-panel dashboard-panel-concepts">
        <div class="panel-header">
            <h2><span class="panel-color-dot concepts-dot"></span>Openstaande klachten</h2>
            <a asp-controller="Klantenservice" asp-action="Index">Klantenservice openen</a>
        </div>
        <div class="list-stack">
            @* foreach loopt door OpenstaandeKlachten uit AdminDashboardViewModel. *@
            @foreach (var klacht in Model.OpenstaandeKlachten)
            {
                <div class="list-row dashboard-row-concepts">
                    <span class="row-icon"><i data-lucide="headset"></i></span>
                    <div><strong>@klacht.Klachtnummer</strong><small>@klacht.KlantNaam · @klacht.Onderwerp</small></div>
                    <a class="badge badge-soft" asp-controller="Klantenservice" asp-action="Index">@klacht.Status</a>
                </div>
            }
        </div>
    </article>

    <article class="panel dashboard-panel dashboard-panel-priority">
        <div class="panel-header">
            <h2><span class="panel-color-dot priority-dot"></span>Hoge prioriteit</h2>
            <a asp-controller="Bestellingen" asp-action="Index" asp-route-prioriteit="Hoog">Orders openen</a>
        </div>
        <div class="list-stack">
            @* foreach loopt door HogePrioriteitBestellingen; de data komt uit BestellingRepository. *@
            @foreach (var bestelling in Model.HogePrioriteitBestellingen)
            {
                <div class="list-row attention-row dashboard-row-priority">
                    <span class="row-icon"><i data-lucide="flame"></i></span>
                    <div><strong>@bestelling.Ordernummer</strong><small>@bestelling.KlantNaam · € @bestelling.Totaal</small></div>
                    <span class="badge badge-warning">@bestelling.Prioriteit</span>
                </div>
            }
        </div>
    </article>
</section>
