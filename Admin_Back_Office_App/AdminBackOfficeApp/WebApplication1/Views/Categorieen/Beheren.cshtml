@model Categorie
@*
    TECHNISCHE VIEW-UITLEG
    Bestand: Views/Categorieen/Beheren.cshtml
    Deze Razor View wordt aangeroepen door de controller/action met dezelfde mapnaam.
    Tag helpers zoals asp-controller, asp-action en asp-route-id genereren veilige MVC-links.
*@
@*
    JUNIOR-UITLEG Views/Categorieen/Beheren.cshtml
    Deze View hoort bij de controller met dezelfde mapnaam.
    Relatie: de controller haalt data op via repositories en geeft die data door aan deze View.
*@
@{ ViewData["Title"] = "Categorie beheren"; }
@section Styles { <link rel="stylesheet" href="~/css/categorieen/beheren.css" asp-append-version="true" /> }

@* Dit scherm is vooral visueel: het laat zien hoe categoriebeheer eruit kan zien. *@
<section class="page-heading"><div><p class="eyebrow">Categorie</p><h1>@Model.Naam beheren</h1><p>@Model.Omschrijving</p></div><a class="btn btn-light" asp-action="Index">Terug</a></section>
<article class="form-card">
    <label>Naam</label><input class="form-control" value="@Model.Naam" />
    <label>Omschrijving</label><textarea class="form-control" rows="4">@Model.Omschrijving</textarea>
    <div class="button-row"><button class="btn btn-primary" type="button">Opslaan</button></div>
</article>
