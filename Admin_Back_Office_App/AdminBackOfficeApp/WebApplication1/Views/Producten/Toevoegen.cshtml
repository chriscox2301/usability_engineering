@model Product
@* Deze View gebruikt Product.cs als formuliermodel. asp-for koppelt inputvelden aan properties van Product. *@
@{
    ViewData["Title"] = "Product toevoegen";
    @* ViewBag-lijsten komen uit ProductenController.VulProductFormulierKeuzes(). *@
    var categorieen = ViewBag.Categorieen as List<string> ?? new List<string>();
    var leveranciers = ViewBag.Leveranciers as List<string> ?? new List<string>();
    var statussen = ViewBag.Statussen as List<string> ?? new List<string>();
    var iconen = ViewBag.Iconen as List<string> ?? new List<string>();
}
@section Styles { <link rel="stylesheet" href="~/css/producten/toevoegen.css" asp-append-version="true" /> }


@*
    JUNIOR-UITLEG Producten/Toevoegen.cshtml
    Relatie met controller: GET toont het formulier, POST slaat op via ProductenController.Toevoegen.
    Relatie met repository: ProductenController gebruikt ProductRepository.VoegProductToe().
    Technisch: dropdowns gebruiken ViewBag-lijsten uit ProductenController.VulProductFormulierKeuzes().
*@
<section class="page-heading">
    <div>
        <p class="eyebrow">Nieuw product</p>
        <h1>Product toevoegen</h1>
        <p>Vul de productinformatie in. Keuzelijsten voorkomen typefouten en zorgen voor consistente data.</p>
    </div>
</section>

@* asp-action bepaalt naar welke POST-action het formulier verstuurd wordt. *@
<form asp-action="Toevoegen" method="post" class="form-card">
    @* asp-validation-summary toont ModelState errors die de controller toevoegt. *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-grid">
        <div><label asp-for="Naam"></label><input asp-for="Naam" class="form-control" /><span asp-validation-for="Naam" class="text-danger small"></span></div>
        <div><label asp-for="Artikelnummer"></label><input asp-for="Artikelnummer" class="form-control" /><span asp-validation-for="Artikelnummer" class="text-danger small"></span></div>
        <div><label asp-for="Merk"></label><input asp-for="Merk" class="form-control" /><span asp-validation-for="Merk" class="text-danger small"></span></div>

        <div>
            <label asp-for="Categorie"></label>
            @* select asp-for="Categorie" bindt de gekozen option aan Product.Categorie. *@
            <select asp-for="Categorie" class="form-select">
                <option value="">Kies een categorie</option>
                @foreach (var categorie in categorieen)
                {
                    <option value="@categorie">@categorie</option>
                }
            </select>
            <span asp-validation-for="Categorie" class="text-danger small"></span>
        </div>

        <div><label asp-for="Prijs"></label><input asp-for="Prijs" class="form-control" /><span asp-validation-for="Prijs" class="text-danger small"></span></div>
        <div><label asp-for="Voorraad"></label><input asp-for="Voorraad" class="form-control" /><span asp-validation-for="Voorraad" class="text-danger small"></span></div>

        <div>
            <label asp-for="Status"></label>
            @* select asp-for="Status" bindt de gekozen option aan Product.Status. *@
            <select asp-for="Status" class="form-select">
                @foreach (var status in statussen)
                {
                    <option value="@status">@status</option>
                }
            </select>
            <span asp-validation-for="Status" class="text-danger small"></span>
            <div id="concept-waarschuwing"
                class="alert alert-warning small py-2 px-3 mt-2 mb-0 @(Model?.IsConcept() == true ? "" : "d-none")" role="status">
                <strong>Let op:</strong> dit product staat op <em>Concept</em> en verschijnt niet op de klantpagina.
            </div>
        </div>

        <div>
            <label asp-for="Leverancier"></label>
            @* select asp-for="Leverancier" bindt de gekozen option aan Product.Leverancier. *@
            <select asp-for="Leverancier" class="form-select">
                <option value="">Kies een leverancier</option>
                @foreach (var leverancier in leveranciers)
                {
                    <option value="@leverancier">@leverancier</option>
                }
            </select>
        </div>

        <div>
            <label asp-for="Icoon"></label>
            @* select asp-for="Icoon" bindt de gekozen option aan Product.Icoon. *@
            <select asp-for="Icoon" class="form-select">
                @foreach (var icoon in iconen)
                {
                    <option value="@icoon">@icoon</option>
                }
            </select>
        </div>

        <div class="full"><label asp-for="Omschrijving"></label><textarea asp-for="Omschrijving" class="form-control" rows="4"></textarea><span asp-validation-for="Omschrijving" class="text-danger small"></span></div>
    </div>

    <div class="button-row"><button class="btn btn-primary" type="submit">Opslaan</button><a class="btn btn-light" asp-action="Index">Annuleren</a></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
			const statusSelect = document.getElementById("Status");
			const waarschuwing = document.getElementById("concept-waarschuwing");
            if (!statusSelect || !waarschuwing) return;
            
            function werkWaarschuwingBij() {
				const isConcept = statusSelect.value.toLowerCase() === "concept";

                waarschuwing.style.display = isConcept ? "" : "none";
            }

            statusSelect.addEventListener("change", werkWaarschuwingBij);
            werkWaarschuwingBij();
        })();
    </script>
}
