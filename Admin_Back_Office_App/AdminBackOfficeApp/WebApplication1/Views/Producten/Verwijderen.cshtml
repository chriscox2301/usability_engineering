@model Product
@*
    TECHNISCHE VIEW-UITLEG
    Bestand: Views/Producten/Verwijderen.cshtml
    Deze Razor View wordt aangeroepen door de controller/action met dezelfde mapnaam.
    Tag helpers zoals asp-controller, asp-action en asp-route-id genereren veilige MVC-links.
*@
@*
    JUNIOR-UITLEG Views/Producten/Verwijderen.cshtml
    Deze View hoort bij de controller met dezelfde mapnaam.
    Relatie: de controller haalt data op via repositories en geeft die data door aan deze View.
*@
@{
    ViewData["Title"] = "Product verwijderen";
    // Concept wordt definitief verwijderd, Actief wordt op Inactief gezet (zie ProductenController.VerwijderenBevestigd).
    var definitief = Model.KanDefinitiefVerwijderdWorden();
}
@section Styles { <link rel="stylesheet" href="~/css/producten/verwijderen.css" asp-append-version="true" /> }

@* Verwijderen toont eerst een bevestiging. Dit voorkomt fouten in professioneel beheer. *@
<section class="page-heading"><div><p class="eyebrow">Bevestigen</p><h1>@(definitief ? "Product verwijderen" : "Product deactiveren")</h1><p>Controleer of je het juiste product hebt gekozen.</p></div></section>
<article class="confirm-card">
    <i data-lucide="triangle-alert"></i>
    <h2>@Model.Naam</h2>
    @if (definitief)
    {
        <p>Dit product staat op Concept en is nooit besteld. Het wordt definitief verwijderd. Dit kan niet ongedaan gemaakt worden.</p>
    }
    else
    {
        <p>Dit product is actief en wordt op Inactief gezet in plaats van definitief verwijderd, zodat oude bestellingen bewaard blijven. Via Wijzigen kun je het later weer op Actief zetten.</p>
    }
    <form asp-action="VerwijderenBevestigd" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button class="btn btn-danger" type="submit">@(definitief ? "Ja, definitief verwijderen" : "Ja, deactiveren")</button>
        <a class="btn btn-light" asp-action="Index">Annuleren</a>
    </form>
</article>
